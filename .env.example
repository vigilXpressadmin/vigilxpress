# ==============================================================================
# VigilXpress Environment Variables Template
#
# IMPORTANT DEPLOYMENT INSTRUCTIONS (Vercel & Hosting Platforms):
# 1. Variables prefixed with NEXT_PUBLIC_* are inlined into the browser bundle
#    at build time. You MUST redeploy after adding or modifying them.
# 2. In Vercel Project Settings > Environment Variables, assign them to:
#    Production, Preview, and Development.
# 3. Server secrets must NEVER have a NEXT_PUBLIC_* prefix.
# ==============================================================================

# ── Public Variables (Client & Server) ─────────────────────────────────────────

# Canonical public website URL (used for Paystack callbacks and OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Public API Key (Anonymous / Publishable key)
# Note: Either NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY or NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLIC_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Paystack Public Key for customer checkout popup
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PAYSTACK_PUBLIC_KEY

# ── Server-Only Secrets (Never exposed to browser) ────────────────────────────

# Paystack Secret Key (for server-side payment initialization & HMAC verification)
PAYSTACK_SECRET_KEY=sk_test_YOUR_PAYSTACK_SECRET_KEY

# Supabase Service Role Key (Used for privileged server tasks and Edge Functions)
# CAUTION: Never prefix this with NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional server configuration:
PAYSTACK_WEBHOOK_IP_ALLOWLIST=
FINANCIAL_POLICY_VERSION=vigilxpress-policy-pending-approval
PLATFORM_COMMISSION_BPS=0
SETTLEMENT_DELAY_HOURS=0

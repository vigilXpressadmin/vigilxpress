# Public values safe for the browser after RLS is enabled
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY

# Server-only values. For Supabase Edge Functions, configure these as secrets, not in Next.js env.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
PAYSTACK_SECRET_KEY=sk_test_YOUR_SECRET_KEY
PAYSTACK_WEBHOOK_IP_ALLOWLIST=
FINANCIAL_POLICY_VERSION=vigilxpress-policy-pending-approval
PLATFORM_COMMISSION_BPS=0
SETTLEMENT_DELAY_HOURS=0
